# ==========================================
# SMART AI AGENCY - ENVIRONMENT VARIABLES
# ==========================================

# Canonical site origin. Drives metadataBase, canonical URLs, og:url/og:image,
# sitemap.xml, robots.txt, llms.txt and the JSON-LD graph.
# Set this to the live domain (with protocol, no trailing slash) in Vercel →
# Project → Settings → Environment Variables, for Production AND Preview.
# Unset, it falls back to the Vercel production URL, then smart-ai-agency.vercel.app.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Voice demo — optional. Without these the "Talk to Sara" demo plays its
# scripted conversation; with them the button places a real web call.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key_here
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Supabase — contact form submissions (server-side only)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Prefer service role for server inserts (optional; falls back to anon key)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Search Console verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code_here
