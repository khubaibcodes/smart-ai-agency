# ==========================================
# SMART AI AGENCY - ENVIRONMENT VARIABLES
# ==========================================
#
# Instructions:
# 1. Copy this file to .env
# 2. Fill in your API keys below
# 3. Never commit .env to version control
#
# ==========================================

# ---- Supabase Database (Optional)
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
# Used for storing contact form submissions to a database
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ---- EmailJS Email Service (Recommended)
# Get these from EmailJS dashboard: https://dashboard.emailjs.com
# 1. Create EmailJS account (free tier available)
# 2. Add Gmail service and create email template
# 3. Copy your Service ID, Template ID, and Public Key below
# This enables direct email notifications from the contact form
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# ---- Google Analytics (Optional)
# Get this from your Google Analytics account
# Used for tracking website analytics and user behavior
VITE_GA_TRACKING_ID=your_google_analytics_id_here
